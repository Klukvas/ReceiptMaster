{
  "name": "receiptmaster",
  "version": "1.0.0",
  "description": "ReceiptMaster - Full-featured trading service with React frontend and NestJS backend",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"yarn backend:dev\" \"yarn frontend:dev\"",
    "build": "yarn backend:build && yarn frontend:build",
    "start": "concurrently \"yarn backend:start\" \"yarn frontend:start\"",
    "backend:dev": "cd backend && yarn start:dev",
    "backend:build": "cd backend && yarn build",
    "backend:start": "cd backend && yarn start",
    "backend:test": "cd backend && yarn test",
    "backend:test:e2e": "cd backend && yarn test:e2e",
    "backend:migration:run": "cd backend && yarn migration:run",
    "backend:migration:generate": "cd backend && yarn migration:generate",
    "frontend:dev": "cd frontend && yarn dev",
    "frontend:build": "cd frontend && yarn build",
    "frontend:start": "cd frontend && yarn start",
    "frontend:test": "cd frontend && yarn test",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:build": "docker-compose build",
    "docker:prod:up": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker-compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker-compose -f docker-compose.prod.yml logs -f",
    "deploy": "./scripts/deploy.sh prod",
    "deploy:hetzner": "./scripts/deploy.sh hetzner",
    "db:init": "docker-compose -f docker-compose.init.yml up -d postgres && docker-compose -f docker-compose.init.yml run --rm db-init && docker-compose -f docker-compose.init.yml down",
    "db:migrate": "yarn workspace backend migration:run",
    "db:backup": "cd backend && ./scripts/backup-db.sh",
    "db:restore": "cd backend && ./scripts/restore-db.sh",
    "install:all": "yarn install && cd backend && yarn install && cd ../frontend && yarn install",
    "clean": "rm -rf node_modules backend/node_modules frontend/node_modules backend/dist frontend/dist",
    "generate:logo-variants": "node scripts/generate-logo-variants.js",
    "generate:invoice-pdfs": "node scripts/generate-invoice-pdfs.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "sharp": "^0.33.5",
    "playwright": "^1.56.1",
    "handlebars": "^4.7.8"
  },
  "engines": {
    "node": ">=20.0.0",
    "yarn": ">=1.22.0"
  },
  "keywords": [
    "nestjs",
    "react",
    "typescript",
    "postgresql",
    "docker",
    "trading",
    "ecommerce"
  ],
  "author": "",
  "license": "MIT"
}

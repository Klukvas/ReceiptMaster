NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=market_db
AUTO_RUN_MIGRATIONS=true
API_PREFIX=api/v1
API_KEY=your-secret-key-here
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
JWT_EXPIRES_IN=24h
RECEIPT_BASE_URL=http://localhost:3000

# Hetzner Object Storage (S3-compatible)
# Используем AWS-совместимые переменные (стандарт для S3-совместимых сервисов)
AWS_ACCESS_KEY_ID=your-object-storage-access-key  # Hetzner Object Storage Access Key
AWS_SECRET_ACCESS_KEY=your-object-storage-secret-key  # Hetzner Object Storage Secret Key
AWS_REGION=fsn1  # Hetzner Object Storage Region
S3_ENDPOINT=https://fsn1.your-objectstorage.com  # Hetzner Object Storage Endpoint
LOGOS_BUCKET=marketflow-storage
RECEIPTS_BUCKET=marketflow-storage
TEMP_BUCKET=marketflow-storage

TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

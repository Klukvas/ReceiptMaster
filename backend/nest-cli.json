{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.build.json",
    "assets": [
      {
        "include": "modules/receipts/templates/html/**/*.html",
        "outDir": "dist"
      },
      {
        "include": "modules/receipts/templates/translations/**/*.json",
        "outDir": "dist"
      }
    ]
  }
}

# Production Environment Variables
# Copy this file to .env.prod and update the values

# GitHub Repository (for Docker images)
GITHUB_REPOSITORY=klukvas/receiptmaster

# Database Configuration
DB_USERNAME=postgres
DB_PASSWORD=your-secure-password
DB_NAME=market_db

# API Configuration
API_KEY=your-production-api-key
VITE_API_KEY=your-production-api-key
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# S3 Object Storage Configuration (Hetzner Object Storage)
AWS_ACCESS_KEY_ID=your-object-storage-access-key
AWS_SECRET_ACCESS_KEY=your-object-storage-secret-key
AWS_REGION=nbg1
S3_ENDPOINT=https://nbg1.your-objectstorage.com
LOGOS_BUCKET=marketflow-storage
RECEIPTS_BUCKET=marketflow-storage
TEMP_BUCKET=marketflow-storage

# Frontend Configuration
VITE_API_URL=/api/v1
RECEIPT_BASE_URL=http://localhost:3000

# pgAdmin Configuration
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=your-pgadmin-password
